# ============================================================
#  ENZO — Smash Burgers & Pizza
#  Konfigurácia pre Apache / LiteSpeed (Websupport)
#  Súbor nahraj spolu so zvyškom obsahu do priečinka `web`.
# ============================================================

Options -Indexes

# Statický web má index.html, ale admin je PHP a má index.php. Keby tu
# index.php nebol, Apache by v /admin/ nenašiel žiadny index, výpis
# priečinka má zakázaný — a vrátil by 403 Forbidden namiesto prihlásenia.
DirectoryIndex index.html index.php

# ---------- Presmerovanie na HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Vlastná stránka 404 ----------
ErrorDocument 404 /404.html

# ---------- MIME typy ----------
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
</IfModule>

# ---------- Kompresia ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ---------- Cache ----------
<IfModule mod_headers.c>
  # Fotky sa dajú vymeniť z adminu pod tým istým názvom, tak sa server
  # musí vždy spýtať, či sa nezmenili. Keď nie, odpovie prázdnym 304 —
  # je to lacné a nová fotka je vidieť hneď, aj na telefóne.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Fonty sa nemenia nikdy — tie sa cachovať oplatí.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML sa nikdy necachuje natvrdo, aby sa zmeny prejavili hneď.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Až nakoniec: súbory v /_next/static/ majú v názve hash, takže sa
  # nikdy nezmenia pod tou istou adresou. Toto pravidlo musí prebiť
  # tie podľa prípony vyššie, preto stojí tu.
  SetEnvIf Request_URI "^/_next/static/" ENZO_IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=ENZO_IMMUTABLE

  # Základné bezpečnostné hlavičky.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
