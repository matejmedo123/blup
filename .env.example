# ─── CREW. — konfigurácia prostredia ────────────────────────────────────────
# Skopíruj na `.env.local` (vývoj) alebo nastav v paneli hostingu (produkcia).
# Súbory .env* sú v .gitignore — do repozitára nepatria.

# ─── Databáza ──────────────────────────────────────────────────────────────
# POVINNÉ v produkcii. Ak chýba alebo nezačína `postgres://`, appka spadne
# späť na PGlite (lokálny WASM Postgres) — to je len pre vývoj.
DATABASE_URL=postgres://user:heslo@host:5432/crew

# `true` pre spravované DB s vlastným certifikátom (Neon, Supabase, RDS).
DATABASE_SSL=true

# Veľkosť poolu na inštanciu. Drž súčin (inštancie × pool) pod limitom DB.
DATABASE_POOL_MAX=10

# Len vývoj: kam si PGlite ukladá dáta. `memory://` = bez perzistencie.
# PGLITE_DATA_DIR=.pglite

# `true` vypne automatické migrácie pri štarte (produkcia migruje krokom v CI).
# CREW_SKIP_AUTO_MIGRATE=true

# ─── Adresa aplikácie ──────────────────────────────────────────────────────
# POVINNÉ v produkcii. Bez neho vedú odkazy v e-mailoch a QR kódoch na
# localhost. Bez lomky na konci, vždy https.
APP_URL=https://crew.tvojadomena.sk

# ─── E-mail ────────────────────────────────────────────────────────────────
# console = vypíše do logu (default) · resend = Resend API · webhook = vlastné
EMAIL_PROVIDER=resend
EMAIL_FROM=CREW. <noreply@tvojadomena.sk>

# Pri EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...

# Pri EMAIL_PROVIDER=webhook — dostane POST {to, subject, html, text}
# EMAIL_WEBHOOK_URL=https://...
# EMAIL_WEBHOOK_TOKEN=...

# ─── Cron ──────────────────────────────────────────────────────────────────
# POVINNÉ, ak chceš pripomienky. Bez neho /api/cron/reminders vracia 503
# a nikomu nechodia notifikácie o smenách. Vygeneruj: openssl rand -hex 32
CRON_SECRET=

# ─── Seed (len prvé naplnenie) ─────────────────────────────────────────────
# V produkcii seed BEZ SEED_ADMIN_PASSWORD zámerne spadne.
# Po prvom prihlásení heslo zmeň a premenné odstráň.
SEED_ADMIN_EMAIL=admin@tvojadomena.sk
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
