# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js auto-generated agent rules
AGENTS.md

# statický export a balík na nahratie
/out/

# backend — konfigurácia s heslami a runtime dáta nikdy nepatria do gitu
/backend/api/config.php
/backend/storage/*
!/backend/storage/.htaccess
*.sqlite
