# ---------------------------------------------------------------------------
# BLUP backend secrets — Supabase Edge Functions ONLY.
#
# These NEVER reach the mobile app. Load them with:
#   supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically in deployed functions; you only need them locally.
# ---------------------------------------------------------------------------

# --- Supabase (local development only) -------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (ticket payments + organizer payouts) --------------------------
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> your endpoint -> signing secret.
# Without this the webhook rejects every request, which is the safe default.
STRIPE_WEBHOOK_SECRET=
# Where Stripe Connect sends the organizer after KYC onboarding
STRIPE_CONNECT_RETURN_URL=blup://organizer/payouts
STRIPE_CONNECT_REFRESH_URL=blup://organizer/payouts

# --- Apple In-App Purchase (Premium) ---------------------------------------
# App Store Connect -> Your app -> App Information -> App-Specific Shared Secret
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.blup.app
# 'sandbox' while testing with a sandbox tester account
APPLE_IAP_ENVIRONMENT=production
# Set to false ONLY in a sandbox environment to relax notification signature checks
APPLE_STRICT_CHAIN_VALIDATION=true

# --- AI (recommendation explanations) --------------------------------------
# The ranking itself is pure SQL and works with no key at all — this only adds
# natural-language explanations for premium users.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Push notifications ----------------------------------------------------
# Optional: only needed if your Expo project enforces push security
EXPO_ACCESS_TOKEN=
