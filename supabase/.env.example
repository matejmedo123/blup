# ---------------------------------------------------------------------------
# BLUP backend secrets — Supabase Edge Functions ONLY.
#
# These NEVER reach the mobile app. Load them with:
#   supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically in deployed functions; you only need them locally.
# ---------------------------------------------------------------------------

# --- Supabase (local development only) -------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (ticket payments + organizer payouts) --------------------------
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> your endpoint -> signing secret.
# Without this the webhook rejects every request, which is the safe default.
STRIPE_WEBHOOK_SECRET=
# Where Stripe Connect sends the organizer after KYC onboarding
# On the web these must be https URLs on your own origin; the blup:// form is
# for the native build only.
STRIPE_CONNECT_RETURN_URL=https://blup.sk/organizer/payouts
STRIPE_CONNECT_REFRESH_URL=https://blup.sk/organizer/payouts

# --- Web (required for the browser launch) ---------------------------------
# The origin the web build is served from. Stripe Checkout returns here and the
# ticket email links here. Must be the real https origin, no trailing slash —
# only paths on it are accepted as return targets, so a wrong value breaks
# checkout rather than silently redirecting somewhere else.
APP_PUBLIC_URL=https://blup.sk

# Premium sold on the web is a Stripe subscription (no App Store commission).
# Create two recurring prices in Stripe and paste their ids here.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# --- Ticket delivery by e-mail ---------------------------------------------
# Resend (resend.com). Without a key the queue records deliveries as "skipped"
# rather than failing — tickets still exist in the app.
RESEND_API_KEY=
# Must be a domain verified in Resend, otherwise every send is rejected.
EMAIL_FROM=Blup <tickets@blup.sk>
EMAIL_REPLY_TO=
# Signing secret from Resend → Webhooks (whsec_...). Without it the bounce
# webhook refuses every request, dead addresses are never recorded, and the
# sending domain's reputation degrades until mail starts landing in spam.
RESEND_WEBHOOK_SECRET=

# --- Web push --------------------------------------------------------------
# Generate both halves with: node scripts/generate-vapid-keys.mjs
# The public half also goes into mobile/.env as EXPO_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@blup.sk

# --- Apple In-App Purchase (Premium) ---------------------------------------
# App Store Connect -> Your app -> App Information -> App-Specific Shared Secret
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.blup.app
# 'sandbox' while testing with a sandbox tester account
APPLE_IAP_ENVIRONMENT=production
# Set to false ONLY in a sandbox environment to relax notification signature checks
APPLE_STRICT_CHAIN_VALIDATION=true

# --- AI (recommendation explanations) --------------------------------------
# The ranking itself is pure SQL and works with no key at all — this only adds
# natural-language explanations for premium users.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Push notifications ----------------------------------------------------
# Optional: only needed if your Expo project enforces push security
EXPO_ACCESS_TOKEN=
