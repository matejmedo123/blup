# Trader — keys and settings for the services. Copy to trader.env (Docker) or /etc/trader/trader.env
# (install-vps.sh does that for you) and keep it private: chmod 600, never commit it, never paste it anywhere.
# Format: KEY=value, one per line; quote values that contain spaces. Leave unused keys empty.
#
# Everything else (risk limits, which assets, notifications on/off, AI desk on/off) lives in
# <state folder>/config.json and limits.json, which the bot creates with safe defaults on first start.

# State folder. Do not set it here: the systemd units use /var/lib/trader, Docker uses /data/trader.
# TRADER_HOME=

# Dashboard password — required for Docker (the container listens on 0.0.0.0) and for Caddy/HTTPS.
# Use a long one: anyone who has it can pause the bot or press KILL.
TRADER_DASHBOARD_PASSWORD=

# SEC asks for a real name and e-mail in the User-Agent to read 8-K filings (free, no account).
# Without it the news & filings gate cannot read filings. Example: "Jana Novakova jana@example.sk"
SEC_USER_AGENT=

# Bybit EU (crypto spot + spot margin) — only if you set autopilot.broker to "bybit". Create the keys WITHOUT the
# withdraw permission and bind them to this server's IP. TESTNET = paper, keys made on testnet.bybit.eu (outside Demo
# Trading); LIVE = real money, keys made on www.bybit.eu. A key works only on the site it was made on.
BYBIT_TESTNET_KEY=
BYBIT_TESTNET_SECRET=
# DEMO = www.bybit.eu's Demo Trading instead of the testnet (autopilot.bybit.paper_venue "demo")
BYBIT_DEMO_KEY=
BYBIT_DEMO_SECRET=
# LIVE = real money. Leave empty unless you have done every live opt-in step in the README.
BYBIT_LIVE_KEY=
BYBIT_LIVE_SECRET=

# Alpaca PAPER account (free, fake money) — only if you set autopilot.broker to "alpaca".
# The default broker is the local simulator, which needs no account and no keys.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Alpaca LIVE account — real money. Leave empty unless you have done every live opt-in step in the README.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# X (Twitter) API bearer token — optional, pay-per-use; the feed respects news.x.max_reads_per_day.
X_BEARER_TOKEN=

# Phone notifications (optional): Telegram bot (create one with @BotFather) …
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# … and/or ntfy (set notify.ntfy_topic in config.json). Only needed for a password-protected ntfy server.
NTFY_TOKEN=

# Optional AI desk (Claude reviews trades the rule-based desk already passed; veto only, budget-capped).
# Also needs ai_desk.enabled true in config.json and the anthropic package (Docker: WITH_AI=1).
ANTHROPIC_API_KEY=
