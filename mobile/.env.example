# ---------------------------------------------------------------------------
# BLUP mobile — PUBLIC configuration only.
#
# Everything here is bundled into the app and is readable by anyone who
# downloads it. Never put a secret key in this file. Server secrets belong in
# the Supabase Edge Function environment (see supabase/.env.example).
#
# Copy to mobile/.env, fill in, then restart with: npx expo start --clear
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Maps ------------------------------------------------------------------
# iOS uses Apple Maps by default and needs no key.
# Android uses Google Maps and DOES need a key with "Maps SDK for Android" on.
EXPO_PUBLIC_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_MAPS_API_KEY_IOS=

# --- Payments (ticket checkout) --------------------------------------------
# Publishable key only — pk_test_... / pk_live_...
# Only the native builds need this — the web build gets its Checkout URL from
# the server, so a browser never holds a Stripe key.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple Pay merchant id, must match the one in your Apple developer account.
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.com.blup.app

# --- Premium (In-App Purchase product ids) ---------------------------------
EXPO_PUBLIC_PREMIUM_PRODUCT_ID_MONTHLY=com.blup.app.premium.monthly
EXPO_PUBLIC_PREMIUM_PRODUCT_ID_YEARLY=com.blup.app.premium.yearly

# --- App identity ----------------------------------------------------------
EXPO_PUBLIC_IOS_BUNDLE_ID=com.blup.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.blup.app
# Domain for universal / app links, e.g. blup.app (leave empty to disable)
EXPO_PUBLIC_DEEPLINK_DOMAIN=

# --- Optional --------------------------------------------------------------
# Walking-time routing provider (falls back to straight-line estimates)
EXPO_PUBLIC_ROUTING_API_KEY=
# Show the AI debug screen in release builds too
EXPO_PUBLIC_DEBUG_AI=false
# Needed for push tokens; `eas init` writes this for you
EAS_PROJECT_ID=

# --- web -------------------------------------------------------------------
# The origin the web build is served from. Used for share cards (og:url,
# og:image); the server has its own APP_PUBLIC_URL for Checkout returns.
EXPO_PUBLIC_WEB_URL=https://blup.app
